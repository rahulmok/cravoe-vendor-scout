  "narrative": {
    "northStar": "The Property Research Desk",
    "overview": "A composed research workspace: a dark navigation spine anchors white property records and a source-rich dossier. Manrope supplies a confident, compact hierarchy; cobalt marks actions and selection, while restrained status colors express evidence quality.\n\nThis is a code-led snapshot scoped to `app/hotels`; the metaphor describes the implemented system and is not a separately approved brand identity.",
    "keyCharacteristics": [
      "Navy navigation and cobalt actions",
      "White evidence-led property rows",
      "Compact Manrope hierarchy",
      "Borders and tonal layers before shadows"
    ],
    "rules": [],
    "dos": [
      "Do keep hotel category, guest rating and fit score visually distinct.",
      "Do pair evidence colors with readable status text.",
      "Do retain visible focus treatment and reduced-motion support."
    ],
    "donts": [
      "Don't use property photography as a substitute for evidence.",
      "Don't spread the action cobalt across every surface.",
      "Don't apply this scoped hotel system to the restaurant scout."
    ]
  }
}
