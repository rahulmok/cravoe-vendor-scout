GOOGLE_PLACES_API_KEY=your_key_here

# Vertex Gemini grounded vendor research (same auth pattern as Cravoe Agent)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=global
GCP_PROJECT_NUMBER=your_gcp_project_number
GCP_SERVICE_ACCOUNT_EMAIL=your_vertex_service_account@your-project.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=your_workload_identity_pool_id
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=your_workload_identity_provider_id

# Optional model override
GEMINI_MODEL=gemini-3.8-flash

# Optional fallback only; not required when Vertex/OIDC is configured
# GEMINI_API_KEY=
