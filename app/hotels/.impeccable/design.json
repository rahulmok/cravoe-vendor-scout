  "narrative": {
    "northStar": "The Dark Destination Contact Sheet",
    "overview": "A destination photographer's contact sheet translated into the user's selected dark luxury direction. Charcoal surfaces, restrained bronze and large real property photographs establish the atmosphere; source-linked creator evidence supplies the substance. Self-hosted Manrope keeps the hierarchy contemporary and composed.\n\nThe user selected dark luxury and code-first. The reference service failed twice; the degraded grounded direction supplied the contact-sheet metaphor. No successful catalog seed key or quality-bar cards were returned. This document records shipped code, not a generated reference specification.",
    "keyCharacteristics": [
      "Large, attributed property photography",
      "Charcoal surfaces with restrained bronze",
      "Visible evidence and uncertainty",
      "Compact mobile setup before the first photograph"
    ],
    "rules": [
      {
        "name": "The Restrained Bronze Rule",
        "body": "Use bronze for action, selection and evidence emphasis; leave the surrounding photography and surfaces visually dominant.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep star category separate from guest review rating.",
      "Do display real photo attribution and linked evidence.",
      "Do use authored SVG arrows for navigation and external actions.",
      "Do keep WhatsApp and email draft bodies consistent with the editable outreach text.",
      "Do preserve visible focus and reduced-motion treatment."
    ],
    "donts": [
      "Don't fabricate property photographs, creator proof or leads for empty states.",
      "Don't hide pending quality or uncertain sponsorship behind a luxury presentation.",
      "Don't apply this hotel system to the restaurant scout."
    ]
  }
